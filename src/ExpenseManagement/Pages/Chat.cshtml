@page
@model ChatModel
@{
    ViewData["Title"] = "AI Chat Assistant";
}

<div class="row mb-4">
    <div class="col">
        <h1 class="display-6">
            <i class="bi bi-chat-dots text-info"></i> 
            AI Chat Assistant
        </h1>
        <p class="text-muted">Ask questions about expenses using natural language</p>
    </div>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm" style="height: 70vh;">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-robot text-info me-2"></i>
                    Chat with AI
                </span>
                @if (!Model.IsGenAIConfigured)
                {
                    <span class="badge bg-warning text-dark">
                        <i class="bi bi-exclamation-triangle me-1"></i>Demo Mode
                    </span>
                }
                else
                {
                    <span class="badge bg-success">
                        <i class="bi bi-check-circle me-1"></i>AI Enabled
                    </span>
                }
            </div>
            <div class="card-body overflow-auto" id="chatMessages" style="flex: 1;">
                <div class="message assistant-message mb-3">
                    <div class="d-flex">
                        <div class="avatar bg-info text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                            <i class="bi bi-robot"></i>
                        </div>
                        <div class="message-content bg-light rounded-3 p-3" style="max-width: 80%;">
                            <p class="mb-0">Hello! I'm your AI assistant for the Expense Management System. I can help you with:</p>
                            <ul class="mb-0 mt-2">
                                <li>Viewing your expenses</li>
                                <li>Creating new expenses</li>
                                <li>Checking expense status</li>
                                <li>Getting expense summaries</li>
                                <li>Approving or rejecting expenses</li>
                            </ul>
                            <p class="mb-0 mt-2">Try asking me something like "Show my expenses" or "What's pending approval?"</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <form id="chatForm" class="d-flex gap-2">
                    <input type="text" id="messageInput" class="form-control" placeholder="Type your message..." autocomplete="off" />
                    <button type="submit" class="btn btn-info text-white" id="sendButton">
                        <i class="bi bi-send"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-transparent">
                <i class="bi bi-lightbulb text-warning me-2"></i>
                Quick Prompts
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-outline-primary text-start quick-prompt">
                        <i class="bi bi-list me-2"></i>Show my expenses
                    </button>
                    <button type="button" class="btn btn-outline-primary text-start quick-prompt">
                        <i class="bi bi-clock me-2"></i>What's pending approval?
                    </button>
                    <button type="button" class="btn btn-outline-primary text-start quick-prompt">
                        <i class="bi bi-pie-chart me-2"></i>Show expense summary by category
                    </button>
                    <button type="button" class="btn btn-outline-primary text-start quick-prompt">
                        <i class="bi bi-bar-chart me-2"></i>Show expense summary by status
                    </button>
                    <button type="button" class="btn btn-outline-primary text-start quick-prompt">
                        <i class="bi bi-tags me-2"></i>What categories are available?
                    </button>
                </div>
            </div>
        </div>

        @if (!Model.IsGenAIConfigured)
        {
            <div class="card border-0 shadow-sm mt-3 border-warning">
                <div class="card-header bg-warning bg-opacity-10">
                    <i class="bi bi-info-circle text-warning me-2"></i>
                    Demo Mode Active
                </div>
                <div class="card-body">
                    <p class="small mb-2">Azure OpenAI is not configured. The chat is running in demo mode with pre-defined responses.</p>
                    <p class="small mb-0">To enable AI features, deploy using <code>deploy-with-chat.sh</code> instead of <code>deploy.sh</code>.</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .message-content {
        word-wrap: break-word;
    }
    .message-content ul, .message-content ol {
        padding-left: 1.2rem;
    }
    .message-content strong {
        color: #0d6efd;
    }
    .user-message .message-content {
        background-color: #0d6efd !important;
        color: white;
    }
</style>

@section Scripts {
    <script>
        const chatMessages = document.getElementById('chatMessages');
        const chatForm = document.getElementById('chatForm');
        const messageInput = document.getElementById('messageInput');
        const sendButton = document.getElementById('sendButton');

        chatForm.addEventListener('submit', async function(e) {
            e.preventDefault();
            const message = messageInput.value.trim();
            if (!message) return;

            addMessage(message, 'user');
            messageInput.value = '';
            sendButton.disabled = true;

            try {
                const response = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ message: message })
                });

                const data = await response.json();
                addMessage(data.message, 'assistant');
            } catch (error) {
                addMessage('Sorry, I encountered an error processing your request.', 'assistant');
            }

            sendButton.disabled = false;
            messageInput.focus();
        });

        document.querySelectorAll('.quick-prompt').forEach(button => {
            button.addEventListener('click', function() {
                const text = this.textContent.trim();
                messageInput.value = text;
                chatForm.dispatchEvent(new Event('submit'));
            });
        });

        function addMessage(content, type) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `message ${type}-message mb-3`;

            const isUser = type === 'user';
            const avatarClass = isUser ? 'bg-primary' : 'bg-info';
            const icon = isUser ? 'person' : 'robot';

            messageDiv.innerHTML = `
                <div class="d-flex ${isUser ? 'justify-content-end' : ''}">
                    ${!isUser ? `<div class="avatar ${avatarClass} text-white rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;"><i class="bi bi-${icon}"></i></div>` : ''}
                    <div class="message-content ${isUser ? 'bg-primary text-white' : 'bg-light'} rounded-3 p-3" style="max-width: 80%;"></div>
                    ${isUser ? `<div class="avatar ${avatarClass} text-white rounded-circle d-flex align-items-center justify-content-center ms-2" style="width: 36px; height: 36px;"><i class="bi bi-${icon}"></i></div>` : ''}
                </div>
            `;

            const contentDiv = messageDiv.querySelector('.message-content');
            contentDiv.innerHTML = formatMessage(content);

            chatMessages.appendChild(messageDiv);
            chatMessages.scrollTop = chatMessages.scrollHeight;
        }

        function formatMessage(text) {
            // Escape HTML first
            let escaped = text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;');

            // Apply markdown-style formatting
            escaped = escaped
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/\n\n/g, '</p><p>')
                .replace(/\n/g, '<br>');

            // Handle numbered lists
            escaped = escaped.replace(/(\d+\.\s.+?)(?=<br>|$)/g, '<li>$1</li>');
            if (escaped.includes('<li>')) {
                escaped = escaped.replace(/(<li>.*<\/li>)+/g, '<ol>$&</ol>');
            }

            // Handle bullet lists
            escaped = escaped.replace(/[-*]\s(.+?)(?=<br>|$)/g, '<li>$1</li>');

            return '<p>' + escaped + '</p>';
        }
    </script>
}
